        <mxCell id="k20" value="B20: Nhận lịch giao, bố trí slot nhận hàng,&#10;nhân sự &amp; khu vực kiểm đầu vào" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#2F6FB0;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="794" y="2878" width="190" height="92" as="geometry"/></mxCell>
