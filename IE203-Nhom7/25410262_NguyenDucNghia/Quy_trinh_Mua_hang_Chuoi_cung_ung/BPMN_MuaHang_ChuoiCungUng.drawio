        <mxCell id="k22a" value="B22a: Cân trọng lượng thực nhận, đối chiếu&#10;số lượng &amp; chủng loại với PO" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#2F6FB0;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1632" y="2878" width="190" height="92" as="geometry"/></mxCell>
